          "marks": null,
          "level": null,
          "mark_range": null,
          "assessment_objective": null,
          "specification_reference": null
        },
        {
          "id": "commentary_09_1-guidance-6",
          "type": "commentary_guidance",
          "text": "Access to Level 2 can be achieved by describing a linked idea.",
          "order": 7,
          "parent_id": null,
          "annotations": [],
          "source": {
            "file": "B-JUN24-84612H-09_1-C.txt",
            "page": null
          },
          "marks": null,
          "level": null,
          "mark_range": null,
          "assessment_objective": null,
          "specification_reference": null
        },
        {
          "id": "commentary_09_1-example-1",
          "type": "commentary_example",
          "text": "Thus, ‘more light for \nphotosynthesis so more glucose is produced’ would achieve this, as would ‘more \nmagnesium to make chlorophyll’.",
          "order": 8,
          "parent_id": null,
          "annotations": [
            {
              "type": "domain_term",
              "text": "light",
              "start": 12,
              "end": 17
            },
