        },
        {
          "id": "commentary_09_1-guidance-7",
          "type": "commentary_guidance",
          "text": "You will see that there are many ways that this level can \nbe reached, as any black bullet point along with an associated white bullet point is all that is \nrequired.",
          "order": 9,
          "parent_id": null,
          "annotations": [
            {
              "type": "qualifier",
              "text": "all",
              "start": 144,
              "end": 147
            },
