            "page": null
          },
          "marks": null,
          "level": null,
          "mark_range": null,
          "assessment_objective": null,
          "specification_reference": null
        },
        {
          "id": "commentary_09_1-guidance-8",
          "type": "commentary_guidance",
          "text": "To reach Level 3, two linked ideas are required, along with a clear indication that glyphosate \nkills weeds but does not affect GM soya (the first black bullet point).",
          "order": 10,
          "parent_id": null,
          "annotations": [
