# Hosted Jev API key (jv_live_...) for evidence-criterion classification
TYPESAFE_API_KEY=jv_live_your-key-here

# Conversation LLM (OpenAI Responses API)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=sk-your-key-here

# Holistic level judgement (llm | fake | jev)
LEVEL_JUDGEMENT_CLASSIFIER=llm
# LEVEL_LLM_MODEL=gpt-4.1-mini

# Optional prompt directory override
# VEA_PROMPTS_DIR=prompts

# Force CPU for BGE embeddings on Windows if CUDA crashes
VEA_EMBED_DEVICE=cpu
